# ── Auto Viral Video Editor — environment configuration ──────────────────
# Copy this file to `.env` (or set these in your host's dashboard) and edit
# the values. Only VITE_API_BASE_URL matters in most setups.

# Frontend → backend API origin.
#   Web build: leave empty/unset (same-origin relative URLs are used).
#   Split hosting (Netlify frontend + Render backend): set to the Render URL.
#   Native Capacitor build: set to your deployed backend URL.
VITE_API_BASE_URL=

# Backend only: extra hosts the /api/music-proxy and /api/download-proxy
# endpoints are allowed to fetch (comma-separated, https only). The defaults
# already cover the stock-media and font hosts the editor uses.
# PROXY_ALLOWED_HOSTS=example-cdn.com,cdn.example.com

# Backend only: optional server-side Gemini key. Every AI feature runs
# client-side with each user's own key (Settings modal), so this is only
# needed if you re-enable the legacy server-side AI routes.
# GEMINI_API_KEY=
